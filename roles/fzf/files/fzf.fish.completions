# fzf completions for fish
# fzf does not ship fish completions; this provides basic path completion.
complete -c fzf -f -x -d 'files and directories' -a '(__fish_complete_paths)'

# Common fzf flags
complete -c fzf -l preview -d 'preview command'
complete -c fzf -l preview-window -d 'preview window layout'
complete -c fzf -l height -d 'height percentage'
complete -c fzf -l layout -d 'layout'
complete -c fzf -l border -d 'border style'
complete -c fzf -l color -d 'color scheme'
complete -c fzf -l header -d 'header text'
complete -c fzf -l header-lines -d 'header lines'
complete -c fzf -l ansi -d 'enable ANSI colors'
complete -c fzf -l phonetic -d 'phonetic hints'
complete -c fzf -l exact -d 'exact match'
complete -c fzf -l extended -d 'extended search'
complete -c fzf -l no-extended -d 'disable extended search'
complete -c fzf -l literal -d 'literal search'
complete -c fzf -l no-literal -d 'disable literal search'
complete -c fzf -l case -d 'case sensitivity'
complete -c fzf -l no-case -d 'ignore case'
complete -c fzf -l tiebreak -d 'tiebreak algorithm'
complete -c fzf -l bind -d 'key bindings'
complete -c fzf -l cycle -d 'enable cyclic scrolling'
complete -c fzf -l no-cycle -d 'disable cyclic scrolling'
complete -c fzf -l reverse -d 'reverse order'
complete -c fzf -l no-reverse -d 'disable reverse order'
complete -c fzf -l select-1 -d 'auto-select single result'
complete -c fzf -l no-select-1 -d 'disable auto-select'
complete -c fzf -l query -d 'initial query'
complete -c fzf -l read0 -d 'read null-separated input'
complete -c fzf -l print0 -d 'print null-separated output'
complete -c fzf -l echo -d 'echo query'
complete -c fzf -l no-echo -d 'disable echo'
complete -c fzf -l multi -d 'enable multi-select'
complete -c fzf -l no-multi -d 'disable multi-select'
complete -c fzf -l mouse -d 'enable mouse support'
complete -c fzf -l no-mouse -d 'disable mouse support'
complete -c fzf -l inline-info -d 'inline info'
complete -c fzf -l no-inline-info -d 'disable inline info'
complete -c fzf -l page -d 'page mode'
complete -c fzf -l sync -d 'synchronous search'
complete -c fzf -l expect -d 'comma-separated keys'
complete -c fzf -l filter -d 'filter command'
complete -c fzf -l version -d 'print version'
complete -c fzf -l help -d 'print help'
