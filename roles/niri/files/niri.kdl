include "keyboard.kdl"
include "window_rules.kdl"
include "layer_rules.kdl"
include "binds.kdl"
include optional=true "colors.kdl"

input {
    keyboard {
        numlock
    }

    touchpad {
        tap
        natural-scroll
        accel-profile "adaptive"
    }

    mouse {
        accel-profile "adaptive"
    }
}

layout {
    gaps 12
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
    }

    border {
        off
    }

    shadow {
        on
        softness 12
        spread 0
        offset x=0 y=5
    }
}

blur {
  passes 2
  offset 3.0
  noise 0.03
  saturation 1.0
}

spawn-at-startup "systemctl" "--user" "import-environment" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP=niri"
spawn-at-startup "noctalia"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

environment {
    QT_QPA_PLATFORM "wayland"
}

debug {
    honor-xdg-activation-with-invalid-serial
}
