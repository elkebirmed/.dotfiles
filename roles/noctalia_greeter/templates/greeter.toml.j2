[session]
default = "{{ noctalia_greeter_default_session }}"

[appearance]
scheme = "Synced"
theme_mode = "dark"

[appearance.palette]
primary = "{{ base16_colors.base0D }}"
on_primary = "{{ base16_colors.base00 }}"
secondary = "{{ base16_colors.base0E }}"
on_secondary = "{{ base16_colors.base00 }}"
tertiary = "{{ base16_colors.base0C }}"
on_tertiary = "{{ base16_colors.base00 }}"
error = "{{ base16_colors.base08 }}"
on_error = "{{ base16_colors.base00 }}"
surface = "{{ base16_colors.base00 }}"
on_surface = "{{ base16_colors.base05 }}"
surface_variant = "{{ base16_colors.base01 }}"
on_surface_variant = "{{ base16_colors.base04 }}"
outline = "{{ base16_colors.base02 }}"
shadow = "{{ base16_colors.base00 }}"
hover = "{{ base16_colors.base02 }}"
on_hover = "{{ base16_colors.base05 }}"

[appearance.wallpaper]
path = "color:{{ base16_colors.base00 }}"

[keyboard]
layout = "{{ keyboard.layout }}"
variant = "{{ keyboard.variant }}"
options = "{{ keyboard.options | join(',') }}"
